let
    recursiveattrset = rec {
        a = " waow" + b;
        b = " meow";
        c = ("meow" + recursiveattrset.b);
        res = recursiveattrset.c + b + waff;
    };
    waff = " waff";
    result = recursiveattrset.res + waff;
in
result + recursiveattrset.b
